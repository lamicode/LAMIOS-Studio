# =============================================================================
# LAMIOS Studio - Environment Configuration Template
# Copy this file to .env for local overrides (never commit .env to GitHub)
# =============================================================================

LAMIOS_ENV=development
LAMIOS_LOG_LEVEL=INFO

# Hardware & Execution Defaults (Optimized for Intel i7-1165G7 / 16GB RAM)
LAMIOS_DEFAULT_DEVICE=cpu
LAMIOS_QUALITY_MODE=balanced
LAMIOS_MAX_RAM_USAGE_PERCENT=75
LAMIOS_CHUNK_DURATION_SECONDS=30
LAMIOS_UNLOAD_MODELS_AFTER_STAGE=true

# Storage Directories (Relative to project root or absolute paths)
LAMIOS_MODELS_DIR=./models/weights
LAMIOS_TEMP_DIR=./temp
LAMIOS_LOGS_DIR=./logs
